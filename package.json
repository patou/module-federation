{
  "name": "migration-federation-demo",
  "type": "module",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": "^22.18.0 || >=24.0.0" },
  "scripts": {
    "dev": "concurrently -k -n shell,vue,angular \"npm run dev -w @demo/shell\" \"npm run dev -w @demo/vue-remote\" \"npm run dev -w @demo/angular-remote\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "preview": "concurrently -k -n shell,vue,angular \"npm run preview -w @demo/shell\" \"npm run preview -w @demo/vue-remote\" \"npm run preview -w @demo/angular-remote\"",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@angular/common": "21.2.0",
    "@angular/compiler": "21.2.0",
    "@angular/core": "21.2.0",
    "@angular/platform-browser": "21.2.0",
    "@angular/router": "21.2.0",
    "rxjs": "^7.8.2",
    "vue": "^3.5.22",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.8.0",
    "@angular/build": "21.2.0",
    "@angular/compiler-cli": "21.2.0",
    "@module-federation/vite": "1.23.4",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vue-tsc": "^3.1.0"
  }
}
